# Public release example configuration for RouterArena-related scripts.
# Copy to `.env` or export these variables in your shell before running scripts.

# Root path of a local RouterArena checkout that contains dataset/ and model_cost/
R2_ROUTERARENA_ROOT=/path/to/RouterArena

# Sweep data and derived training artifacts
R2_SWEEP_ROOT=/path/to/budget_sweep
R2_TRAINING_DATA_PATH=/path/to/category_router/training_data.pkl
R2_CHECKPOINT_DIR=/path/to/router/checkpoints/category_router

# Dataset and metadata files
R2_ROUTER_DATA_PATH=/path/to/RouterArena/dataset/router_data.json
R2_ROUTER_DATA_10_PATH=/path/to/RouterArena/dataset/router_data_10.json
R2_ROBUSTNESS_DATA_PATH=/path/to/RouterArena/dataset/router_robustness.json
R2_MODEL_COST_PATH=/path/to/RouterArena/model_cost/model_cost.json

# Embeddings
R2_EMBEDDINGS_PATH=/path/to/router/routerarena_submission/routerarena_embeddings.pkl
R2_ROBUSTNESS_EMBEDDINGS_PATH=/path/to/router/routerarena_submission/routerarena_robustness_embeddings.pkl

# Optional helper path used by scripts/merge_predictions.py
R2_PREDICTIONS_DIR=/path/to/RouterArena/router_inference/predictions
